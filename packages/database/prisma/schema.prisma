generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmailTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  ANNUAL
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum ResumeAnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ResumeProposalType {
  PROFILE_FIELD
  EXPERIENCE
  EDUCATION
  CERTIFICATION
  SKILL
}

enum ResumeProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  passwordHash    String
  displayName     String?
  status          UserStatus        @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     WorkspaceMember[]
  refreshSessions RefreshSession[]
  emailTokens     EmailToken[]
  careerProfiles  CareerProfile[]
  uploadedResumes Resume[]          @relation("ResumeUploader")

  @@index([createdAt])
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model EmailToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  type       EmailTokenType
  tokenHash  String         @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@index([expiresAt])
}

model Workspace {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  slug           String               @unique
  status         WorkspaceStatus      @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        WorkspaceMember[]
  careerProfiles CareerProfile[]
  sources        Source[]
  discoveryRuns  SourceDiscoveryRun[]
  discoveryCandidates DiscoveryCandidate[]
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  workspaceId String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@index([userId])
}

model CareerProfile {
  id                  String                    @id @default(uuid()) @db.Uuid
  workspaceId         String                    @db.Uuid
  userId              String                    @db.Uuid
  headline            String?
  professionalSummary String?                   @db.Text
  currentLocation     String?
  yearsOfExperience   Int?
  linkedinUrl         String?
  portfolioUrl        String?
  websiteUrl          String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  workspace           Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences         CareerExperience[]
  educations          CareerEducation[]
  certifications      CareerCertification[]
  skills              CareerProfileSkill[]
  preferences         CareerPreference?
  resumes             Resume[]
  resumeAnalyses      ResumeAnalysis[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
}

model CareerExperience {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @db.Uuid
  careerProfileId String          @db.Uuid
  title           String
  company         String
  location        String?
  employmentType  EmploymentType?
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  isCurrent       Boolean         @default(false)
  description     String?         @db.Text
  achievements    String[]        @default([])
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  careerProfile   CareerProfile   @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, careerProfileId, sortOrder])
}

model CareerEducation {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  careerProfileId String        @db.Uuid
  institution     String
  qualification   String?
  fieldOfStudy    String?
  location        String?
  startDate       DateTime?     @db.Date
  endDate         DateTime?     @db.Date
  grade           String?
  description     String?       @db.Text
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  careerProfile   CareerProfile @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, careerProfileId, sortOrder])
}

model CareerCertification {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @db.Uuid
  careerProfileId String        @db.Uuid
  name            String
  issuer          String?
  credentialId    String?
  credentialUrl   String?
  issuedAt        DateTime?     @db.Date
  expiresAt       DateTime?     @db.Date
  doesNotExpire   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  careerProfile   CareerProfile @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, careerProfileId])
}

model Skill {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String               @unique
  createdAt      DateTime             @default(now())
  profileSkills  CareerProfileSkill[]
}

model CareerProfileSkill {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @db.Uuid
  careerProfileId String           @db.Uuid
  skillId         String           @db.Uuid
  proficiency     SkillProficiency?
  yearsExperience Decimal?         @db.Decimal(4, 1)
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  careerProfile   CareerProfile    @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)
  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([careerProfileId, skillId])
  @@index([workspaceId, careerProfileId])
  @@index([skillId])
}

model CareerPreference {
  id                    String           @id @default(uuid()) @db.Uuid
  workspaceId           String           @db.Uuid
  careerProfileId       String           @unique @db.Uuid
  desiredJobTitles      String[]         @default([])
  preferredLocations   String[]         @default([])
  industries            String[]         @default([])
  employmentTypes       EmploymentType[] @default([])
  workModes             WorkMode[]       @default([])
  minSalaryAmount       Decimal?         @db.Decimal(12, 2)
  maxSalaryAmount       Decimal?         @db.Decimal(12, 2)
  salaryCurrency        String?
  salaryPeriod          SalaryPeriod?
  willingToRelocate     Boolean          @default(false)
  requiresSponsorship   Boolean?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  careerProfile         CareerProfile    @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, careerProfileId])
  @@index([workspaceId])
}

model Resume {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  careerProfileId   String        @db.Uuid
  uploadedByUserId  String        @db.Uuid
  fileName          String
  mimeType          String
  fileSizeBytes     Int
  storageProvider   String        @default("firebase")
  storageKey        String        @unique
  checksumSha256    String
  status            ResumeStatus  @default(UPLOADED)
  extractedText     String?       @db.Text
  parseError        String?       @db.Text
  parsedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  careerProfile     CareerProfile @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)
  uploadedBy        User          @relation("ResumeUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  analyses          ResumeAnalysis[]

  @@unique([workspaceId, checksumSha256])
  @@index([workspaceId, careerProfileId, createdAt])
  @@index([uploadedByUserId])
  @@index([status, createdAt])
}

model ResumeAnalysis {
  id                 String               @id @default(uuid()) @db.Uuid
  workspaceId        String               @db.Uuid
  careerProfileId    String               @db.Uuid
  resumeId           String               @db.Uuid
  provider           String
  model              String
  status             ResumeAnalysisStatus @default(QUEUED)
  summary            String?              @db.Text
  extraction         Json?
  missingInformation String[]              @default([])
  weakAreas          Json?
  error              String?              @db.Text
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  careerProfile      CareerProfile        @relation(fields: [workspaceId, careerProfileId], references: [workspaceId, id], onDelete: Cascade)
  resume             Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  proposals          ResumeProfileProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, resumeId, createdAt])
  @@index([status, createdAt])
}

model ResumeProfileProposal {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  analysisId  String               @db.Uuid
  type        ResumeProposalType
  payload     Json
  evidence    String               @db.Text
  confidence  Decimal              @db.Decimal(3, 2)
  status      ResumeProposalStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime             @default(now())
  analysis    ResumeAnalysis       @relation(fields: [workspaceId, analysisId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, analysisId, status])
}

enum OpportunitySourceType {
  JOB_BOARD
  COMPANY_CAREERS
  AGGREGATOR
  GOVERNMENT
  OTHER
}

enum SourceChannel {
  WEBSITE
  FEED
  API
  SOCIAL
  SUBMISSION
}

enum SourceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SourceCrawlMethod {
  AUTO
  HTTP
  BROWSER
}

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum DiscoveryTrigger {
  MANUAL
  SCHEDULED
}

enum DiscoveryMethod {
  SITEMAP
  RSS
  ATOM
  HTML_LINK
  MANUAL
}

enum DiscoveryCandidateStatus {
  DISCOVERED
  QUEUED
  REJECTED
}

model Source {
  id                       String                @id @default(uuid()) @db.Uuid
  workspaceId              String                @db.Uuid
  name                     String
  baseUrl                  String                @db.VarChar(2048)
  canonicalUrl             String                @db.VarChar(2048)
  sourceType               OpportunitySourceType
  channel                  SourceChannel          @default(WEBSITE)
  providerKey              String?
  supportedOpportunityTypes String[]              @default(["JOB"])
  status                   SourceStatus          @default(ACTIVE)
  crawlMethod              SourceCrawlMethod     @default(AUTO)
  crawlIntervalMinutes     Int                   @default(360)
  maxPagesPerRun           Int                   @default(20)
  requestsPerMinute        Int                   @default(6)
  notes                    String?               @db.Text
  lastCrawledAt            DateTime?
  lastCrawlStatus          String?
  lastCrawlError           String?               @db.Text
  nextDiscoveryAt          DateTime              @default(now())
  discoveryLeaseExpiresAt  DateTime?
  lastDiscoveryAt          DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discoveryRuns            SourceDiscoveryRun[]
  discoveryCandidates      DiscoveryCandidate[]

  @@unique([workspaceId, canonicalUrl])
  @@index([workspaceId, status, updatedAt])
  @@index([status, nextDiscoveryAt, discoveryLeaseExpiresAt])
}

model SourceDiscoveryRun {
  id               String             @id @default(uuid()) @db.Uuid
  workspaceId      String             @db.Uuid
  sourceId         String             @db.Uuid
  status           DiscoveryRunStatus @default(QUEUED)
  trigger          DiscoveryTrigger
  startedAt        DateTime?
  completedAt      DateTime?
  discoveredCount  Int                @default(0)
  newCount         Int                @default(0)
  rejectedCount    Int                @default(0)
  error            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source           Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([sourceId, status, createdAt])
}

model DiscoveryCandidate {
  id                String                   @id @default(uuid()) @db.Uuid
  workspaceId       String                   @db.Uuid
  sourceId          String                   @db.Uuid
  url               String                   @db.VarChar(2048)
  canonicalUrl      String                   @db.VarChar(2048)
  discoveredFromUrl String                   @db.VarChar(2048)
  method            DiscoveryMethod
  status            DiscoveryCandidateStatus  @default(DISCOVERED)
  firstSeenAt       DateTime                 @default(now())
  lastSeenAt        DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source            Source                  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, canonicalUrl])
  @@index([workspaceId, status, lastSeenAt])
  @@index([sourceId, lastSeenAt])
}
