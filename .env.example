# Opportunity Intelligence environment configuration
# Copy this file to .env at the repository root.
# The API and worker load this shared environment file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# API HTTP port
API_PORT=4000

# Exact browser origin allowed by the API CORS configuration
WEB_ORIGIN=http://localhost:5173

# Frontend base URL used to construct verification and password-reset links.
# Required in production. Defaults to http://localhost:5173 otherwise.
APP_URL=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database and background jobs
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunity_intelligence?schema=public

# Redis connection string used by the worker and BullMQ
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Authentication and cookies
# ---------------------------------------------------------------------------

# Required. Use a cryptographically random secret of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters

# Access-token lifetime in seconds (default: 900 / 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-session lifetime in days (default: 30)
REFRESH_TOKEN_TTL_DAYS=30

# Optional cookie domain. Leave unset for local development.
# Set to your parent domain when deploying across subdomains, e.g. example.com.
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------

# Required in production. Create this in your Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxx

# Required in production. Must use a sender/domain verified in Resend.
# Keep the display name and email address together.
EMAIL_FROM="Opportunity Intelligence <noreply@example.com>"

# ---------------------------------------------------------------------------
# Firebase Storage (private bucket)
# Create a service account with least-privilege Storage access. Never commit its credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ---------------------------------------------------------------------------
# AI resume analysis (OpenAI-compatible chat-completions endpoint)
# AI_API_KEY=your-provider-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=your-structured-output-capable-model

# ---------------------------------------------------------------------------
# Environment variable checklist
# ---------------------------------------------------------------------------
# API config: NODE_ENV, API_PORT, WEB_ORIGIN, APP_URL, DATABASE_URL,
# REDIS_URL, LOG_LEVEL, JWT_ACCESS_SECRET, ACCESS_TOKEN_TTL_SECONDS,
# REFRESH_TOKEN_TTL_DAYS, COOKIE_DOMAIN, RESEND_API_KEY, EMAIL_FROM,
# FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, FIREBASE_STORAGE_BUCKET, AI_API_KEY, AI_BASE_URL, AI_MODEL.
#
# The worker currently reads LOG_LEVEL and REDIS_URL from this same file.
# Docker Compose currently defines its local PostgreSQL/Redis credentials
# directly in infrastructure/docker-compose.yml; it does not read extra
# environment variables from this file.
