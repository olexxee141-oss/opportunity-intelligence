NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opportunity_intelligence?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Resend: create an API key and verify the sending domain first.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Opportunity Intelligence <noreply@example.com>
# COOKIE_DOMAIN=localhost
